# ============================================================
#  .env.example — Copy this to .env and fill in real values
#  DO NOT put real keys here. This file is committed to git.
# ============================================================

# ---- LLM: OpenRouter (Primary) ----
# Get a free key at https://openrouter.ai
ROUTERAI_API_KEY=your-openrouter-api-key-here
DEEPSEEK_MODEL_NAME=google/gemini-flash-1.5

# ---- LLM: Ollama (Local Fallback) ----
# Run: ollama pull mistral:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ---- Vector Store: Qdrant ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# ---- Cache & Sessions: Redis ----
REDIS_URL=redis://localhost:6379

# ---- RAG Tuning ----
CANDIDATE_K=20
FINAL_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=200
EXTRACT_MAX_TOKENS=768
SYNTH_MAX_TOKENS=768

# ---- Auth (JWT) ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- API Keys (for document loaders / optional) ----
HUGGINGFACE_API_KEY=your-hf-api-key-here

# ---- Observability (optional) ----
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=rag-production

# ---- Cross-Encoder Reranker ----
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Strict mode for fact verification ----
STRICT_VERBATIM=false
